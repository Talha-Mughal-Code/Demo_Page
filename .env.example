# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your key.  `.env` is git-ignored.
# The key is read server-side only and is NEVER sent to the browser.
# ---------------------------------------------------------------------------

# Required. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-replace-me

# Optional. Any vision-capable Chat Completions model.
# Default: gpt-5.6-terra   (good intelligence/cost balance, accepts image input)
# Alternatives: gpt-5.6-sol, gpt-5.5, gpt-5.4, gpt-5.4-mini, gpt-4o
OPENAI_MODEL=gpt-5.6-terra

# Optional. Output budget per evaluation. This covers the model's internal
# reasoning as well as the JSON it writes. Default: 4000 with a catalog loaded,
# 2500 without. Raise it if you ever see "ran out of output budget".
# OPENAI_MAX_OUTPUT_TOKENS=6000

# Optional. Port for the local server.
PORT=3000

# Optional. Override the OpenAI base URL (Azure OpenAI / proxy / gateway).
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional. Send the catalog reference photos to the model with each evaluation.
# Default: true when a catalog is imported. Set false to send the text list only.
# CATALOG_REFERENCE_IMAGES=false
# CATALOG_REFERENCE_IMAGE_LIMIT=24
